[Unit]
Description=AI System API
After=network.target

[Service]
Type=simple
User=ai-system
WorkingDirectory=/opt/ai-system
EnvironmentFile=/opt/ai-system/.env
ExecStart=/opt/ai-system/.venv/bin/uvicorn api.main:app --host 0.0.0.0 --port 8001 --workers 2
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
